# The Lenny Growth Assistant Environment Variables

# LLM Providers Configuration
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Active Provider: ollama, anthropic, openai, fallback
DEFAULT_PROVIDER=ollama

# Database Configuration (Defaults to local SQLite if POSTGRES_URL not provided)
DATABASE_URL=sqlite:///./lenny_assistant.db
# DATABASE_URL=postgresql://lenny:lenny_secret@postgres:5432/lenny_db

# Server Config
HOST=0.0.0.0
PORT=8000
